{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naeem-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "supermood-blog",
      "database_id": "c6e9e12a-6681-45d1-af84-2ef6cf62c927"
    }
  ]
}
