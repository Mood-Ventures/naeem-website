{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "naeem-website",
  "main": "src/worker.js",
  "compatibility_date": "2025-01-01",
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/podcast",
      "/podcast/",
      "/podcast.html",
      "/rudy-rodriguez-navy-veteran-sales-coach",
      "/rudy-rodriguez-navy-veteran-sales-coach/",
      "/rudy-rodriguez-navy-veteran-sales-coach.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "BLOG_DB",
      "database_name": "supermood-blog",
      "database_id": "c6e9e12a-6681-45d1-af84-2ef6cf62c927",
      "migrations_dir": "migrations"
    }
  ]
  // KIT_API_KEY is a Worker secret (`wrangler secret put KIT_API_KEY`). Never commit it.
}
